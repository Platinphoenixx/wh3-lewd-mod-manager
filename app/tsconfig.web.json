{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@catalog/*": ["../catalog/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/renderer/**/*", "src/preload/*.d.ts", "src/shared/**/*", "../catalog/schema.ts"]
}
