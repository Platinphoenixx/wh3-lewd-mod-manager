{
  "_comment": "Legendary lords of Total War: Warhammer III with their race, starting faction and the DLC that makes them playable. Source: the Total War Warhammer wiki's tables of legendary lords (read 2026-11-10). build_catalog.py makes a 'vanilla' template for every lord the catalog has a look for and no campaign mod already makes playable. 'recommends' go to every such template, 'factionRecommends' and 'factionAvoid' to the templates of that faction (catalog tags).",
  "_source": "https://totalwarwarhammer.fandom.com/wiki/Total_War:_Warhammer_III_legendary_lords",
  "recommends": [
    {
      "target": {
        "mod": "ll-46165"
      },
      "note": "its Light version (the one for every faction other than Beastmen) plays matched animations when Beastmen fight female units; female reskins of the army are its targets"
    },
    {
      "target": {
        "mod": "ll-34542"
      },
      "note": "its version for non-Slaanesh factions: dilemmas when you vassalize or confederate female legendary lords"
    },
    {
      "target": {
        "mod": "ll-36630"
      },
      "note": "event chains when you defeat female legendary lords; works with any faction, says its author"
    }
  ],
  "factionAvoid": {
    "wood elves": [
      {
        "target": {
          "mod": "ll-42028"
        },
        "note": "it changes the Wood Elf mechanics for Alarielle; its page says not to play Wood Elves with it active (crashes, script errors)"
      },
      {
        "target": {
          "mod": "steam-3575516470"
        },
        "note": "it gives Alarielle the Wood Elf forest mechanics; its page says the Wood Elves' own mechanics break with it"
      },
      {
        "target": {
          "mod": "steam-3619883986"
        },
        "note": "a patch of Alarielle's Wood Elf mechanics for Immortal Empires Expanded; its page says not to play Wood Elves with it"
      }
    ]
  },
